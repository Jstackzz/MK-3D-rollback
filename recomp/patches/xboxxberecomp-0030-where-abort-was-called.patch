 DWORD g_window_thread = 0;     // the thread the window and its messages run on (wWinMain's)
 
+const wchar_t* BaseName(const wchar_t* path) { return std::wcsrchr(path, L'\\') ? std::wcsrchr(path, L'\\') + 1 : path; }
+
+// the module an address is in and its file name ("?" for none)
+HMODULE ModuleOf(const void* at, wchar_t (&path)[MAX_PATH]) {
+    HMODULE mod = nullptr;
+    path[0] = L'?';
+    path[1] = 0;
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<LPCWSTR>(at), &mod))
+        GetModuleFileNameW(mod, path, MAX_PATH);
+    return mod;
+}
+
+const char* ThreadKind() {
+    const kernel::Thread* t = kernel::Current();
+    return t && t->ctx ? "a game thread" : GetCurrentThreadId() == g_window_thread ? "the window thread" : "a host thread";
+}
+
+// abort() comes without an exception record. Where it was called from: the first return addresses on the stack in
+// the game's own modules (the executable and its code DLL, which share a name) past this handler and the C runtime's
+// raise, abort and terminate, e.g. "MKD.exe+1459A4 (MKD.exe+147ABC MKD.dll+5F21C)"
+void AbortCaller(char* out, size_t size) {
+    void* frames[48];
+    const USHORT n = RtlCaptureStackBackTrace(0, 48, frames, nullptr);
+    wchar_t exe[MAX_PATH] = L"";
+    GetModuleFileNameW(nullptr, exe, MAX_PATH);
+    const wchar_t* exe_name = BaseName(exe);
+    const wchar_t* dot = std::wcsrchr(exe_name, L'.');
+    const size_t stem = dot ? size_t(dot - exe_name) : std::wcslen(exe_name);
+    size_t len = 0;
+    int found = 0;
+    bool past_handler = false;
+    out[0] = 0;
+    for (USHORT i = 0; i < n && found < 3 && len + 64 < size; i++) {
+        wchar_t path[MAX_PATH];
+        HMODULE mod = ModuleOf(frames[i], path);
+        const wchar_t* name = BaseName(path);
+        if (!mod || _wcsnicmp(name, exe_name, stem) != 0 || name[stem] != L'.') {
+            past_handler = true;
+            continue;
+        }
+        if (!past_handler) continue;
+        const auto off = (unsigned long long)(reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(mod));
+        len += size_t(std::snprintf(out + len, size - len, found == 0 ? "%ls+%llX" : found == 1 ? " (%ls+%llX" : " %ls+%llX",
+                                    name, off));
+        found++;
+    }
+    if (found > 1) std::snprintf(out + len, size - len, ")");
+    if (!found) std::snprintf(out, size, "?");
+}
+
