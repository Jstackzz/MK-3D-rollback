-        GetModuleFileNameW(mod, path, MAX_PATH);
-    const wchar_t* name = std::wcsrchr(path, L'\\') ? std::wcsrchr(path, L'\\') + 1 : path;
-    const kernel::Thread* t = kernel::Current();
-    LOGE("crash: %08lX at %ls+%llX on %s", r->ExceptionCode, name,
-         (unsigned long long)(at - reinterpret_cast<uintptr_t>(mod)),
-         t && t->ctx ? "a game thread" : GetCurrentThreadId() == g_window_thread ? "the window thread" : "a host thread");
+    wchar_t path[MAX_PATH];
+    HMODULE mod = ModuleOf(r->ExceptionAddress, path);
+    LOGE("crash: %08lX at %ls+%llX on %s", r->ExceptionCode, BaseName(path),
