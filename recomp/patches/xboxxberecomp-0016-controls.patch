+std::string Utf8(const std::filesystem::path& p) {
+    const auto s = p.u8string();  // char8_t from C++20 on
+    return std::string(s.begin(), s.end());
+}
+
+enum class Read { Ok, CannotOpen, Bad };
+
+// the file's controls over the defaults: [keys] each control's keys, [buttons] the control each controller button
+// presses ("" nothing), keyboard = false turns the keyboard off
+Read ReadControls(const std::filesystem::path& file, Controls& c) {
+    std::ifstream in(file, std::ios::binary);
+    if (!in) return Read::CannotOpen;
+    std::ostringstream text;
+    text << in.rdbuf();
+    const std::string name = Utf8(file);
+    toml::table t;
+    try {
+        t = toml::parse(text.str(), name);
+    } catch (const toml::parse_error& e) {
+        LOGR("input: %s line %u: %s; the controls stay as they were", name.c_str(), unsigned(e.source().begin.line),
+             std::string(e.description()).c_str());
+        return Read::Bad;
+    }
+    if (const std::optional<bool> on = t["keyboard"].value<bool>()) c.keyboard = *on;
+#ifdef _WIN32
+    if (const toml::table* keys = t["keys"].as_table())
+        for (const auto& [control_name, value] : *keys) {
+            const int control = ControlFromName(control_name.str());
+            if (control < 0) {
+                LOGR("input: %s: [keys] has no %s", name.c_str(), std::string(control_name.str()).c_str());
+                continue;
+            }
+            std::vector<int>& list = c.keys[control];
+            list.clear();
+            auto add = [&](const toml::node& n) {
+                const std::optional<std::string> key = n.value<std::string>();
+                if (const int vk = key ? KeyFromName(*key) : 0) list.push_back(vk);
+                else LOGR("input: %s: %s: not a key", name.c_str(), key ? key->c_str() : "?");
+            };
+            if (const toml::array* a = value.as_array()) {
+                for (const toml::node& n : *a) add(n);
+            } else {
+                add(value);
+            }
+        }
+#endif
+    if (const toml::table* buttons = t["buttons"].as_table())
+        for (const auto& [source_name, value] : *buttons) {
+            const int source = SourceFromName(source_name.str());
+            if (source < 0) {
+                LOGR("input: %s: [buttons] has no %s", name.c_str(), std::string(source_name.str()).c_str());
+                continue;
+            }
+            const std::string target = value.value_or(std::string());
+            const int control = target.empty() ? -1 : ControlFromName(target);
+            if (!target.empty() && control < 0) LOGR("input: %s: %s: no such button", name.c_str(), target.c_str());
+            c.presses[source] = control;
+        }
+    return Read::Ok;
+}
+
+std::filesystem::path FindControls() {
+#ifdef _WIN32
+    if (const wchar_t* v = _wgetenv(L"XBE_CONTROLS"); v && *v) return v;
+#else
+    if (const char* v = std::getenv("XBE_CONTROLS"); v && *v) return v;
+#endif
+    std::filesystem::path dir = app::ExeDir();
+    for (int i = 0; i < 6; i++) {
+        std::error_code ec;
+        if (std::filesystem::is_regular_file(dir / "controls.toml", ec)) return dir / "controls.toml";
+        if (!dir.has_parent_path() || dir.parent_path() == dir) break;
+        dir = dir.parent_path();
+    }
+    return {};
+}
+
+// g_lock held: finds the file at the first call, then looks at it again once a second
+void WatchControls() {
+    static bool found = false;
+    const auto now = std::chrono::steady_clock::now();
+    if (!found) {
+        found = true;
+        g_controls_file = FindControls();
+        if (g_controls_file.empty()) LOGR("input: no controls file, the default controls");
+    } else if (now - g_controls_checked < std::chrono::seconds(1)) {
+        return;
+    }
+    g_controls_checked = now;
+    if (g_controls_file.empty()) return;
+    std::error_code ec;
+    const std::filesystem::file_time_type time = std::filesystem::last_write_time(g_controls_file, ec);
+    if (ec) {
+        if (g_controls_read) {
+            LOGR("input: %s is gone, the default controls", Utf8(g_controls_file).c_str());
+            g_controls = Defaults();
+            g_controls_read = false;
+        } else if (g_controls_time == std::filesystem::file_time_type{}) {
+            LOGR("input: the default controls until %s is written", Utf8(g_controls_file).c_str());
+        }
+        g_controls_time = std::filesystem::file_time_type::min();  // said once
+        return;
+    }
+    if (time == g_controls_time) return;
+    Controls c = Defaults();
+    switch (ReadControls(g_controls_file, c)) {
+        case Read::CannotOpen: return;  // being replaced: the next look reads it
+        case Read::Bad: g_controls_time = time; return;
+        case Read::Ok: break;
+    }
+    g_controls_time = time;
+    g_controls = std::move(c);
+    g_controls_read = true;
+    LOGR("input: controls from %s%s", Utf8(g_controls_file).c_str(), g_controls.keyboard ? "" : ", keyboard off");
+}
+
+// a press of v (0-255) on a control: a digital button is down above the threshold, an analog one takes the strongest
+// of what presses it
+void Press(Pad& p, int control, uint8_t v) {
+    if (control < kA) {
+        if (v > kDigitalThreshold) p.buttons |= uint16_t(1u << control);
+    } else {
+        p.analog[control - kA] = std::max(p.analog[control - kA], v);
+    }
+}
