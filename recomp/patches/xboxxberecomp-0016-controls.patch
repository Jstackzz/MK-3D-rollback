+bool SameText(std::string_view a, std::string_view b) {
+    return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+               return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+           });
+}
+
+bool Digits(std::string_view s) {
+    return !s.empty() && std::all_of(s.begin(), s.end(), [](char c) { return std::isdigit(static_cast<unsigned char>(c)); });
+}
+
+int ControlFromName(std::string_view s) {
+    for (int i = 0; i < kControls; i++)
+        if (SameText(s, kControlNames[i])) return i;
+    return -1;
+}
+
+int SourceFromName(std::string_view s) {
+    for (int i = 0; i < kSourceCount; i++)
+        if (SameText(s, kSources[i].name)) return i;
+    return -1;
+}
+
+#ifdef _WIN32
+// Keys in the file: a letter or a digit, F1-F24, Num0-Num9, these, or a virtual key code as 0xNN. Signs are named
+// after a US keyboard; the virtual key is what counts, whatever the layout prints on it.
+const std::pair<const char*, int> kKeyNames[] = {
+    {"Up", VK_UP}, {"Down", VK_DOWN}, {"Left", VK_LEFT}, {"Right", VK_RIGHT},
+    {"Space", VK_SPACE}, {"Enter", VK_RETURN}, {"Backspace", VK_BACK}, {"Tab", VK_TAB}, {"CapsLock", VK_CAPITAL},
+    {"Shift", VK_SHIFT}, {"LShift", VK_LSHIFT}, {"RShift", VK_RSHIFT},
+    {"Ctrl", VK_CONTROL}, {"LCtrl", VK_LCONTROL}, {"RCtrl", VK_RCONTROL},
+    {"Insert", VK_INSERT}, {"Delete", VK_DELETE}, {"Home", VK_HOME}, {"End", VK_END},
+    {"PageUp", VK_PRIOR}, {"PageDown", VK_NEXT},
+    {"NumMultiply", VK_MULTIPLY}, {"NumAdd", VK_ADD}, {"NumSubtract", VK_SUBTRACT}, {"NumDecimal", VK_DECIMAL},
+    {"NumDivide", VK_DIVIDE},
+    {"Semicolon", VK_OEM_1}, {"Equals", VK_OEM_PLUS}, {"Comma", VK_OEM_COMMA}, {"Minus", VK_OEM_MINUS},
+    {"Period", VK_OEM_PERIOD}, {"Slash", VK_OEM_2}, {"Grave", VK_OEM_3}, {"LBracket", VK_OEM_4},
+    {"Backslash", VK_OEM_5}, {"RBracket", VK_OEM_6}, {"Apostrophe", VK_OEM_7}, {"Oem8", VK_OEM_8},
+    {"Oem102", VK_OEM_102},
+};
+
+int KeyFromName(std::string_view s) {
+    if (s.size() == 1 && std::isalnum(static_cast<unsigned char>(s[0])))
+        return std::toupper(static_cast<unsigned char>(s[0]));
+    for (const auto& [name, vk] : kKeyNames)
+        if (SameText(s, name)) return vk;
+    if (s.size() >= 2 && (s[0] == 'F' || s[0] == 'f') && Digits(s.substr(1))) {
+        const int n = std::atoi(std::string(s.substr(1)).c_str());
+        if (n >= 1 && n <= 24) return VK_F1 + n - 1;
+    }
+    if (s.size() == 4 && SameText(s.substr(0, 3), "Num") && Digits(s.substr(3))) return VK_NUMPAD0 + (s[3] - '0');
+    if (s.size() > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+        char* end = nullptr;
+        const std::string hex(s.substr(2));
+        const long v = std::strtol(hex.c_str(), &end, 16);
+        if (end && !*end && v > 0 && v < 0xFF) return int(v);
+    }
+    return 0;
+}
+#endif
