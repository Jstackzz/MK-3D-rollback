+#ifdef _WIN32
+// The keyboard as the controller on port 0, merged with a pad there: arrows or WASD move (the d-pad), J I K L are the
+// face buttons X Y A B (the four attacks of a fighting game's default layout), Space the right trigger (block), O the
+// left trigger, U and P white and black, Enter START, Backspace BACK. Only while one of this process's windows is in
+// front, so typing elsewhere never reaches the game.
+bool KeyboardOn() {
+    static const bool on = [] {
+        const char* v = std::getenv("XBE_KEYBOARD");
+        return !v || std::atoi(v) != 0;
+    }();
+    return on;
+}
+
+bool OurWindowInFront() {
+    HWND w = GetForegroundWindow();
+    DWORD pid = 0;
+    if (w) GetWindowThreadProcessId(w, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+void MergeKeyboard(Pad& p) {
+    p.connected = true;  // a PC always has its keyboard
+    if (!OurWindowInFront()) return;
+    auto down = [](int vk) { return (GetAsyncKeyState(vk) & 0x8000) != 0; };
+    // d-pad up, down, left, right, start, back
+    const int dpad[6][2] = {{VK_UP, 'W'}, {VK_DOWN, 'S'}, {VK_LEFT, 'A'}, {VK_RIGHT, 'D'}, {VK_RETURN, 0}, {VK_BACK, 0}};
+    for (int i = 0; i < 6; i++)
+        if (down(dpad[i][0]) || (dpad[i][1] && down(dpad[i][1]))) p.buttons |= uint16_t(1 << i);
+    // analog buttons: A B X Y black white, left trigger, right trigger
+    const int analog[8] = {'K', 'L', 'J', 'I', 'P', 'U', 'O', VK_SPACE};
+    for (int i = 0; i < 8; i++)
+        if (down(analog[i])) p.analog[i] = 0xFF;
+}
+#endif
+
