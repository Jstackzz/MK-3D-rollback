+// ---- the frame clock (xdk/dsound.h) ----
+namespace dsound {
+
+void SetFrameClock(bool on) {
+    std::lock_guard<std::recursive_mutex> voices(g_lock);  // a real time mix in progress finishes first
+    if (g_frame_clock == on) return;
+    g_frame_clock = on;
+    std::lock_guard<std::mutex> lock(g_fifo_lock);
+    g_fifo.clear();
+    LOGI("dsound: %s", on ? "voices move with the simulated frames" : "voices move in real time");
+}
+
+bool FrameClock() { return g_frame_clock; }
+
+void MixFrames(uint32_t frames, bool output) {
+    if (!g_frame_clock || !frames) return;
+    static std::vector<float> bins;  // the main thread alone mixes on the frame clock
+    bins.assign(size_t(frames) * kBins, 0.0f);
+    {
+        std::lock_guard<std::recursive_mutex> lock(g_lock);
+        for (auto& [obj, v] : g_voices) {
+            if (v.paused || v.sync || (!v.stream && !v.playing)) continue;
+            bool foreign = Foreign(v);
+            if (foreign && !output) continue;  // moved once, with the frame that is heard
+            if (!foreign) Keep(obj);
+            MixVoice(v, bins.data(), frames);
+        }
+        if (!output) return;
+        if (dsp::Loaded()) dsp::Run(bins.data(), frames);
+    }
+    static std::vector<float> out;
+    out.resize(size_t(frames) * 2);
+    Fold(bins, out.data(), frames);
+    std::lock_guard<std::mutex> lock(g_fifo_lock);
+    g_fifo.insert(g_fifo.end(), out.begin(), out.end());
+    if (g_fifo.size() > kFifoMax) g_fifo.erase(g_fifo.begin(), g_fifo.begin() + ptrdiff_t(g_fifo.size() - kFifoKeep));
+}
+
+}  // namespace dsound
