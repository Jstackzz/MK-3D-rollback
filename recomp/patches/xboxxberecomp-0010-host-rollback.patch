+
+void JournalUndo(uint32_t frame) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    while (!g_alloc_journal.empty() && g_alloc_journal.back().frame >= frame) {
+        AllocRecord r = g_alloc_journal.back();
+        g_alloc_journal.pop_back();
+        if (r.alloc) {
+            ReallyFree(r.pool, r.va);  // an allocation that never happened
+        } else {
+            // a free that never happened: the same block again (only another thread could have taken it since)
+            Ranges& pool = r.pool == kPoolSystem ? g_system : g_contig;
+            if (pool.TakeAt(r.va, r.size)) Commit(r.va, r.size);
+            else LOGE("memory: undoing a free, %08X+%X was taken by another thread", r.va, r.size);
+        }
+    }
+}
+
+void JournalConfirm(uint32_t frame) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    size_t n = 0;
+    while (n < g_alloc_journal.size() && g_alloc_journal[n].frame < frame) n++;
+    g_alloc_journal.erase(g_alloc_journal.begin(), g_alloc_journal.begin() + ptrdiff_t(n));
+}
+
+void JournalEnd() {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    g_alloc_journal.clear();
+}
