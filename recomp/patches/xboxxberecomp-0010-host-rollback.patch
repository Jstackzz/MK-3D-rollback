diff --git a/runtime/kernel/host_rollback.cpp b/runtime/kernel/host_rollback.cpp
new file mode 100644
index 0000000..3675314
--- /dev/null
+++ b/runtime/kernel/host_rollback.cpp
@@ -0,0 +1,63 @@
+// Recording of host-side effects for a game layer's rollback; see host_rollback.h.
+#include "kernel/host_rollback.h"
+
+#include <atomic>
+#include <thread>
+#include <vector>
+
+namespace host_rollback {
+namespace {
+
+std::vector<Participant>& Parts() {
+    static std::vector<Participant> v;
+    return v;
+}
+std::atomic<bool> g_on{false};
+std::thread::id g_thread;
+uint32_t g_frame = 0;
+std::atomic<uint32_t> g_recordings{0};
+
+void Started(uint32_t frame) {
+    g_frame = frame;
+    for (const Participant& p : Parts())
+        if (p.frame) p.frame(frame);
+}
+
+}  // namespace
+
+void Register(const Participant& p) { Parts().push_back(p); }
+
+bool Recording() { return g_on.load(std::memory_order_acquire) && std::this_thread::get_id() == g_thread; }
+bool Active() { return g_on.load(std::memory_order_acquire); }
+uint32_t CurrentFrame() { return g_frame; }
+uint32_t Recordings() { return g_recordings.load(std::memory_order_acquire); }
+
+void Begin(uint32_t frame) {
+    g_recordings.fetch_add(1, std::memory_order_acq_rel);
+    g_thread = std::this_thread::get_id();
+    g_on.store(true, std::memory_order_release);
+    Started(frame);
+}
+
+void Frame(uint32_t frame) {
+    if (g_on) Started(frame);
+}
+
+void Undo(uint32_t frame) {
+    if (!g_on) return;
+    for (auto it = Parts().rbegin(); it != Parts().rend(); ++it) it->undo(frame);
+    Started(frame);
+}
+
+void Confirm(uint32_t frame) {
+    if (!g_on) return;
+    for (const Participant& p : Parts()) p.confirm(frame);
+}
+
+void End() {
+    if (!g_on) return;
+    g_on = false;
+    for (const Participant& p : Parts()) p.end();
+}
+
+}  // namespace host_rollback
diff --git a/runtime/kernel/host_rollback.h b/runtime/kernel/host_rollback.h
new file mode 100644
index 0000000..6ba15d4
--- /dev/null
+++ b/runtime/kernel/host_rollback.h
@@ -0,0 +1,45 @@
+#pragma once
+// Host-side state of a title's simulation under a game layer's rollback.
+//
+// Rollback netplay rewinds the simulation to an earlier frame and runs it again. The game layer puts guest memory
+// back itself, but the runtime keeps some of what the guest sees outside guest memory: pool allocations, kernel
+// objects' signal states and handles, DirectSound voices. While recording, the effects one thread (the title's main
+// thread) has on that state are kept per frame so a rollback can undo them. Effects that cannot be taken back once
+// done (memory freed, and maybe handed out again) are held back until their frame is final.
+//
+// Every call is made on the recording thread, between frames.
+#include <cstdint>
+
+namespace host_rollback {
+
+// at the top of `frame`: from now on this thread's effects are recorded as that frame's
+void Begin(uint32_t frame);
+// the top of the next frame to run
+void Frame(uint32_t frame);
+// back to the top of `frame`: the recorded effects of it and every later frame are undone, newest first; the next
+// frame to run is `frame` again (no Frame call needed)
+void Undo(uint32_t frame);
+// frames before `frame` will never be undone: their records go and what they held back is carried out
+void Confirm(uint32_t frame);
+// stop recording; everything held back is carried out
+void End();
+
+// true on the recording thread while recording
+bool Recording();
+// true while recording, on any thread (other threads can stay out of the way)
+bool Active();
+// the frame effects are recorded as
+uint32_t CurrentFrame();
+// counts Begin calls: bookkeeping that belongs to one recording compares it
+uint32_t Recordings();
+
+// a subsystem that records effects
+struct Participant {
+    void (*frame)(uint32_t frame);  // may be null: a frame starts (Begin, Frame, the end of Undo)
+    void (*undo)(uint32_t frame);
+    void (*confirm)(uint32_t frame);
+    void (*end)();
+};
+void Register(const Participant& p);
+
+}  // namespace host_rollback
