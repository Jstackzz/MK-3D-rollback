+#pragma once
+// DirectSound on the simulation's clock, for netplay and rollback (the HLE itself is xdk/dsound.cpp).
+//
+// Normally the output device's thread moves every voice on in real time, so what the title reads back (a buffer's
+// status and play cursor, its notification events) depends on when it asks. With the frame clock on, the output
+// plays what MixFrames queued, and MixFrames (on the title's main thread, once per simulated frame) moves the voices
+// on by that many frames. The title then reads the same values on every peer and in every run of a frame.
+//
+// Voices that other threads drive (CRI's streaming buffers, which those threads refill as they play) are not part of
+// the simulation: they move only with the frames queued for output, so a frame that a rollback runs again moves them
+// once. The main thread's own voices are recorded for kernel/host_rollback.h.
+#include <cstdint>
+
+namespace dsound {
+
+void SetFrameClock(bool on);
+bool FrameClock();
+// output: queue the frames for the speakers (a frame shown), else mix to nowhere (a frame a rollback runs again)
+void MixFrames(uint32_t frames, bool output);
+
+}  // namespace dsound
