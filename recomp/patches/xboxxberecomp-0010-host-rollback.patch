+// ---- rollback (kernel/host_rollback.h): the recording thread's pool allocations and frees, per frame ----
+namespace {
+
+enum Pool : uint8_t { kPoolContiguous, kPoolSystem };
+// Frees are done at once, like allocations, so the pools are always what the frames run so far made them, whether a
+// frame runs the first time or again after a rollback; undoing a free takes the same block back.
+struct AllocRecord {
+    uint32_t frame;
+    Pool pool;
+    bool alloc;  // else a free
+    uint32_t va, size;
+};
+std::vector<AllocRecord> g_alloc_journal;  // oldest first, under g_lock
+
+void Record(Pool pool, bool alloc, uint32_t va, uint32_t size) {
+    if (host_rollback::Recording()) g_alloc_journal.push_back({host_rollback::CurrentFrame(), pool, alloc, va, size});
+}
+
+void ReallyFree(Pool pool, uint32_t va) {
+    uint32_t size;
+    if (pool == kPoolSystem) g_system.Free(va);
+    else if (g_contig.Free(va, &size)) Decommit(va, size);
