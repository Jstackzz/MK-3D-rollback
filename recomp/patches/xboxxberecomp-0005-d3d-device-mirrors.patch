+// (near, far, which): the Z range vertices are clipped to, for vertex programs (1) or fixed function (2), or back
+// to the default range (3, 4). The library pushes them with the viewport; the renderer clips to the viewport's
+// depth range alone, so they are kept for it and not yet applied.
+HLE_STDCALL(D3DDevice_SetDepthClipPlanes, 3) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    uint32_t which = a[2];
+    if (which < 1 || which > 4) return 0x8876086Cu;  // D3DERR_INVALIDCALL
+    int set = which <= 2 ? int(which) - 1 : -1, reset = which >= 3 ? int(which) - 3 : -1;  // 0 program, 1 fixed
+    if (set >= 0) {
+        g_state.clip_planes[set][0] = ArgF(a, 0);
+        g_state.clip_planes[set][1] = ArgF(a, 1);
+        g_state.clip_planes_set |= 1u << set;
+    } else {
+        g_state.clip_planes_set &= ~(1u << reset);
+    }
+    // where the library keeps them, for the recompiled getter: fixed function first, the bit of each set range
+    if (XDK_CDevice_ClipPlanes != xdk::kUnknown) {
+        uint32_t at = kDevice + XDK_CDevice_ClipPlanes;
+        uint32_t fixed = 1, program = 0;  // indexes of g_state.clip_planes
+        if (set == fixed || set == program) {
+            uint32_t slot = set == fixed ? 0u : 8u;
+            W32(at + slot, a[0]);
+            W32(at + slot + 4, a[1]);
+        }
+        uint32_t bits = 0;
+        if (g_state.clip_planes_set & (1u << fixed)) bits |= 1;
+        if (g_state.clip_planes_set & (1u << program)) bits |= 2;
+        W32(at + 0x10, (R32(at + 0x10) & ~3u) | bits);
+    }
+    LOG_FIRST(4, "d3d: SetDepthClipPlanes %g %g (%u), not applied", ArgF(a, 0), ArgF(a, 1), which);
+    return 0;
+}
