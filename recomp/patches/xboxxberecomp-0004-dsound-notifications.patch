+constexpr uint32_t kOffsetStop = 0xFFFFFFFF;  // DSBPN_OFFSETSTOP
+
+void Signal(uint32_t handle) {
+    if (ObjectRef e = FromHandle(handle)) SetEvent(*e);
+}
+
+// the buffer stopped: its DSBPN_OFFSETSTOP events
+void NotifyStop(Voice& v) {
+    for (const Voice::Notify& n : v.notify)
+        if (n.offset == kOffsetStop) Signal(n.event);
+}
+
+// the cursor moved on to frame f: events at the frames it passed since seen, through the end of the loop and
+// round to its start when it wrapped
+void NotifyPassed(Voice& v, uint32_t f, bool wrapped, uint32_t start, uint32_t end) {
+    if (int64_t(f) == v.seen && !wrapped) return;
+    for (const Voice::Notify& n : v.notify) {
+        if (n.offset == kOffsetStop || n.offset < v.play_start) continue;
+        int64_t x = FramesOf(v, n.offset - v.play_start);
+        bool passed = wrapped ? (x > v.seen && x < int64_t(end)) || (x >= int64_t(start) && x <= int64_t(f))
+                              : x > v.seen && x <= int64_t(f);
+        if (passed) Signal(n.event);
+    }
+    v.seen = f;
+}
+
 // the buffer's frame at its position, looping or stopping at the end of its region; none once stopped
 std::optional<Cursor> BufferFrame(Voice& v) {
     uint32_t f = uint32_t(v.pos);
     uint32_t start = v.looping ? FramesOf(v, v.loop_start) : 0;
     uint32_t end = FramesOf(v, v.looping ? v.loop_start + v.loop_len : v.play_len);
+    bool wrapped = false;
     if (f >= end) {
         if (!v.looping || end <= start) {
+            if (!v.notify.empty()) NotifyPassed(v, end ? end - 1 : 0, false, start, end);
             v.playing = false;
             v.pos = 0;
+            v.seen = 0;
+            NotifyStop(v);
             return std::nullopt;
         }
         v.pos = start + std::fmod(v.pos - start, double(end - start));
         f = uint32_t(v.pos);
+        wrapped = true;
     }
+    if (!v.notify.empty()) NotifyPassed(v, f, wrapped, start, end);
+    else v.seen = f;
     if (!v.data) return std::nullopt;
     uint32_t base = v.data + v.play_start;
     Cursor at = {base, f, base, f};
