diff --git a/runtime/core/log.h b/runtime/core/log.h
--- a/runtime/core/log.h
+++ b/runtime/core/log.h
@@ -35,3 +35,10 @@ inline constexpr bool kVerbose = true;
         static std::atomic<int> _c{0};                     \
         if (_c.fetch_add(1, std::memory_order_relaxed) < (n)) LOGI(__VA_ARGS__); \
     } while (0)
+
+// the same at the Report level: in a release build's log too (LOGI is not)
+#define LOGR_FIRST(n, ...)                                 \
+    do {                                                   \
+        static std::atomic<int> _c{0};                     \
+        if (_c.fetch_add(1, std::memory_order_relaxed) < (n)) LOGR(__VA_ARGS__); \
+    } while (0)
diff --git a/runtime/xdk/d3d8.cpp b/runtime/xdk/d3d8.cpp
--- a/runtime/xdk/d3d8.cpp
+++ b/runtime/xdk/d3d8.cpp
@@ -911,8 +911,8 @@ HLE_STDCALL(D3DDevice_SetPalette, 2) {
         g_state.palettes[stage] = pal;
     } else if (g_state.palettes[stage]) {
         HoldPalette(stage);  // before the release, which may free the palette
-        LOG_FIRST(4, "d3d: SetPalette(%u, NULL) from %08X: the stage keeps its palette, as the console's GPU does",
-                  stage, R32(ctx.esp));
