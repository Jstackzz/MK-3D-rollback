+// A display changed while the game was not in front (ApplyDisplayWhenActive), applied now that it is: a moment later,
+// so a restore that brought the window back has placed it first (one asked for by another program places it after the
+// activation, where it was before it was minimized, over what was applied)
+void ApplySoon(HWND hwnd) {
+    if (!g_apply_on_activate || g_apply_posted || !IsWindowVisible(hwnd)) return;
+    g_apply_on_activate = false;
+    g_apply_posted = true;
+    SetTimer(hwnd, kApplyTimer, 250, nullptr);
+}
