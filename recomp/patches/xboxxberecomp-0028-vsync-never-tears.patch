+// vsync was chosen otherwise while the game runs, and whether frames may tear changed with it, which only a new swap
+// chain can: the old one goes first (a window has one flip model swap chain at a time)
+void D3D12Backend::RecreateSwap() {
+    Flush();
+    for (auto& f : frames_) {
+        if (f.fence) WaitFence(f.fence);
+    }
+    for (auto& b : bb_) b.Reset();
+    if (latency_) CloseHandle(latency_);
+    latency_ = nullptr;
+    swap_.Reset();
+    HWND hwnd = static_cast<HWND>(app::Window());
+    for (int tries = 1; !CreateSwapChain(hwnd); tries++) {
+        if (tries == 4) {
+            LOGE("d3d12: no new swap chain");
+            std::abort();
+        }
+        Sleep(100);
+    }
+    CreateBackBufferViews();
+}
