 void ApplyDisplay() { PostMessageW(g_hwnd, kApplyDisplay, 0, 0); }
+
+void ApplyDisplayWhenActive() {
+    g_apply_on_activate = true;
+    // already in front: no activation is coming (unless one took the flag just now); a minimized window waits for its
+    // restore, it never comes back by itself
