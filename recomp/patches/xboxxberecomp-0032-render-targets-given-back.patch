+// Now and then in every log: what the renderer holds and how full the video memory is, so a session's log shows
+// what grew before something was drawn wrong (XBE_GPU_STATUS_EVERY=<presents>, 7200 by default: two minutes)
+void D3D12Backend::LogGpuStatus() {
+    size_t colour = 0, depth = 0;
+    for (const auto& [key, tg] : targets_) (tg.depth ? depth : colour)++;
+    DXGI_QUERY_VIDEO_MEMORY_INFO vm{};
+    const bool mem = adapter3_ && SUCCEEDED(adapter3_->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &vm));
+    LOGR("gpu: %zu textures, %zu colour and %zu depth targets (%zu and %zu views free)%s", textures_.size(), colour,
+         depth, free_rtv_.size(), free_dsv_.size(),
+         mem ? (", video memory " + std::to_string(vm.CurrentUsage >> 20) + " of " + std::to_string(vm.Budget >> 20) +
+                " MB")
+                   .c_str()
+             : "");
+}
