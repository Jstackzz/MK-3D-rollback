+// A session renders into ever new places (each stage's surfaces where the game's heap put them, a match game plays
+// stage after stage), and a target is kept until its size changes: once every view was taken, a new target could not
+// be made and what the game drew into it was lost (textures flickering, a floor drawn black, the health bars gone).
+// The targets unused longest, none used within kTargetIdleFrames, give theirs back: an eighth of the pool at most.
+size_t D3D12Backend::EvictTargets(bool depth) {
+    std::vector<std::pair<uint64_t, uint64_t>> idle;  // last used, key
+    for (const auto& [key, tg] : targets_) {
+        if (tg.depth != depth) continue;
+        auto u = target_used_.find(tg.data);
+        uint64_t used = u == target_used_.end() ? 0 : u->second;
+        if (used + kTargetIdleFrames < frame_) idle.emplace_back(used, key);
+    }
+    std::sort(idle.begin(), idle.end());
+    const size_t want = std::max<size_t>(1, (depth ? kDsvCount : kRtvCount) / 8);
+    size_t n = 0;
+    for (const auto& [used, key] : idle) {
+        if (n >= want) break;
+        if (auto it = targets_.find(key); it != targets_.end()) {
+            ReleaseTarget(it);
+            n++;
+        }
+    }
+    LOGR("d3d12: every %s view was taken (%zu targets held): %zu unused longest gave theirs back",
+         depth ? "depth" : "colour", targets_.size() + n, n);
+    return n;
+}
