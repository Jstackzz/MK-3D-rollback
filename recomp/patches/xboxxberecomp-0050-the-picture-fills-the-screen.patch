+Rect FrameRect(float w, float h) {
+    if (Get().stretch_4x3 || w <= 0 || h <= 0) return {0, 0, std::max(w, 0.0f), std::max(h, 0.0f)};
+    const float aspect = Widescreen() ? 16.0f / 9.0f : 4.0f / 3.0f;
+    const float fw = std::min(w, h * aspect), fh = fw / aspect;
+    return {(w - fw) / 2, (h - fh) / 2, fw, fh};
+}
+
+float FrameAspect() {
+    // the window's client area the last time it showed, w << 32 | h (a minimized one has none to speak of)
+    static std::atomic<uint64_t> shown{0};
+    const HWND hwnd = static_cast<HWND>(Window());
+    if (RECT rc{}; hwnd && !IsIconic(hwnd) && GetClientRect(hwnd, &rc) && rc.right >= 64 && rc.bottom >= 64)
+        shown = uint64_t(rc.right) << 32 | uint32_t(rc.bottom);
+    float w, h;
+    if (const uint64_t last = shown) {
+        w = float(last >> 32);
+        h = float(uint32_t(last));
+    } else {
+        // not shown yet: a window as large as asked for, else one over its monitor (the other modes)
+        const Mode m = Get().display_mode == DisplayMode::Windowed ? Output() : Desktop();
+        w = float(m.width);
+        h = float(m.height);
+    }
+    const Rect r = FrameRect(w, h);
+    return r.w > 0 && r.h > 0 ? r.w / r.h : 16.0f / 9.0f;
+}
+
 float RenderScale(uint32_t guest_height) {
     float h = Output().height * (Get().render_percent / 100.0f);
     return guest_height ? std::max(h / guest_height, 0.1f) : 1.0f;
