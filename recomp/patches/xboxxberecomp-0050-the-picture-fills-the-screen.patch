+// Fullscreen switches the monitor to the size Settings ask for, but not to the desktop's own size (switching to it
+// anyway blanks the screen for nothing), nor to a size of another shape than the desktop's: the monitor or its
+// graphics driver would fit such a mode to the screen as each happens to be set, stretched on one PC and between bars
+// or small in the middle on the next. The window covers the monitor at its own mode then, the game draws at the size
+// asked for (Output) and its picture is stretched or kept to its shape as Settings say (FrameRect), the same on every PC
+bool ModeChange(const Settings& s, const DEVMODEW& desktop) {
+    if (s.display_mode != DisplayMode::Fullscreen || !s.width || !s.height) return false;
+    if (s.width == desktop.dmPelsWidth && s.height == desktop.dmPelsHeight) return false;
+    if (!desktop.dmPelsWidth || !desktop.dmPelsHeight) return true;  // the desktop's size unknown: as asked
+    const double asked = double(s.width) / s.height, own = double(desktop.dmPelsWidth) / desktop.dmPelsHeight;
+    return std::abs(asked / own - 1) < 0.02;  // the same shape: 1366x768 or 1280x720 on a 1920x1080 desktop
+}
+
+// the desktop's mode on the game window's monitor, as the registry keeps it
+DEVMODEW DesktopMode(MONITORINFOEXW& mi) {
+    mi.cbSize = sizeof(mi);
+    GetMonitorInfoW(MonitorFromWindow(g_hwnd, MONITOR_DEFAULTTOPRIMARY), &mi);
+    DEVMODEW desktop{};
+    desktop.dmSize = sizeof(desktop);
+    if (!EnumDisplaySettingsW(mi.szDevice, ENUM_REGISTRY_SETTINGS, &desktop)) desktop.dmPelsWidth = desktop.dmPelsHeight = 0;
+    return desktop;
+}
