+// Rollback (host_rollback.h): the position the recording thread leaves a file at, per frame. A frame run again then
+// reads from where it read the first time, also when it reads on from the file's position rather than at an offset.
+struct PosRecord {
+    uint32_t frame;
+    std::shared_ptr<File> file;
+    uint64_t pos;
+};
+std::mutex g_pos_lock;
+std::vector<PosRecord> g_pos_journal;
+
+void KeepPos(const std::shared_ptr<File>& f) {
+    if (!host_rollback::Recording()) return;
+    std::lock_guard<std::mutex> lock(g_pos_lock);
+    g_pos_journal.push_back({host_rollback::CurrentFrame(), f, f->pos});
+}
+
+void PosUndo(uint32_t frame) {
+    std::lock_guard<std::mutex> lock(g_pos_lock);
+    while (!g_pos_journal.empty() && g_pos_journal.back().frame >= frame) {
+        g_pos_journal.back().file->pos = g_pos_journal.back().pos;
+        g_pos_journal.pop_back();
+    }
+}
+
+void PosConfirm(uint32_t frame) {
+    std::lock_guard<std::mutex> lock(g_pos_lock);
+    size_t n = 0;
+    while (n < g_pos_journal.size() && g_pos_journal[n].frame < frame) n++;
+    g_pos_journal.erase(g_pos_journal.begin(), g_pos_journal.begin() + ptrdiff_t(n));
+}
+
+void PosEnd() { PosConfirm(UINT32_MAX); }
+
+std::atomic<uint64_t> g_recorded_reads{0};
+
+const bool g_pos_registered = (host_rollback::Register({nullptr, PosUndo, PosConfirm, PosEnd}), true);
