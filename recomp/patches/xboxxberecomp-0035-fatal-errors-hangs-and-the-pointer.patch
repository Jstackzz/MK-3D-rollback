+// A window whose thread takes no messages for 5 s turns white ("Not Responding"), which a player takes for a crash
+// and ends from outside, leaving nothing in the log. Once a run: a line ("hang: ...", which a front end reports when
+// the game is then ended) and the guest threads' stacks; a line again if it answers after all. No dump from in here:
+// a process dumping itself stops its own threads, and the game stood still after one.
+void WatchWindow() {
+    std::thread([] {
+        constexpr DWORD kNoAnswerMs = 5000;
+        bool logged = false;
+        while (IsWindow(g_hwnd)) {
+            Sleep(1000);
+            const auto t0 = std::chrono::steady_clock::now();
+            DWORD_PTR result = 0;
+            if (SendMessageTimeoutW(g_hwnd, WM_NULL, 0, 0, SMTO_NORMAL, kNoAnswerMs, &result)) continue;
+            if (GetLastError() != ERROR_TIMEOUT && GetLastError() != 0) return;  // the window is gone
+            LOGE("hang: the game window has not answered for %lu s (Windows shows it as not responding)",
+                 kNoAnswerMs / 1000);
+            if (!logged) {
+                logged = true;
+                LogGuestThreads();
+            }
+            logx::Flush();
+            SendMessageW(g_hwnd, WM_NULL, 0, 0);  // until it answers
+            LOGW("window: answering again after %.0f s",
+                 std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count());
+            logx::Flush();
+        }
+    }).detach();
+}
