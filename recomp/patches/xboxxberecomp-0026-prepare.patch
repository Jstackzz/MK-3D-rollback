+// The DLL this PC just built is new to every antivirus (each PC builds its own, from its own disc), and one may take it
+// for malware: Windows Security quarantines it, or blocks loading it. What the player can do about it.
+void ShowBlocked(const fs::path& dll) {
+    std::wstring name = dll.filename().wstring();
+    std::wstring text = L"Windows Security (or another antivirus) blocked or removed " + name +
+                        L", the game's code this PC built from your disc. That is a false alarm: each PC builds its "
+                        L"own copy of it, so no antivirus has seen the file before.\n\nTo play, open Windows Security "
+                        L"> Virus & threat protection > Protection history, pick the entry for " + name +
+                        L" and choose Actions > Restore (or Allow on device). Then start the game again.";
+    MessageBoxW(nullptr, text.c_str(), kGame.title, MB_ICONWARNING);
+}
