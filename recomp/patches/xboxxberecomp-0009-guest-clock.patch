diff --git a/runtime/kernel/kernel.h b/runtime/kernel/kernel.h
index f684dfc..ed1a18a 100644
--- a/runtime/kernel/kernel.h
+++ b/runtime/kernel/kernel.h
@@ -124,6 +124,17 @@ ObjectRef FromHandle(uint32_t handle);
 // fault cannot happen in user mode. A game layer that write-protects guest pages to track changes (rollback
 // netplay) registers a hook to make the range writable first.
 using GuestWriteHook = void (*)(uint32_t va, uint32_t len);
+
+// The clock the guest reads (time stamp counter, performance counter, interrupt time, tick count) in nanoseconds
+// since boot: real time unless a game layer installs a hook (netplay makes it a function of the simulated frame on
+// the main thread, so every peer and every replay of a frame reads the same times). While a hook is installed the
+// timer thread leaves KeTickCount and the interrupt time alone; the game layer calls PublishGuestTime on its own
+// thread to write them.
+using ClockHook = uint64_t (*)();
+void SetClockHook(ClockHook hook);
+uint64_t GuestNanoseconds();
+uint64_t RealNanoseconds();
+void PublishGuestTime();
 void SetGuestWriteHook(GuestWriteHook hook);
 void BeforeGuestWrite(uint32_t va, uint32_t len);
 bool CloseHandle(uint32_t handle);
