+// F3: the window as the player saw it, the game's overlays (names, panels) too: the back buffer copied out as it is,
+// its alpha made opaque (a swap chain's buffers can only be copied, never sampled)
+void D3D12Backend::CapSaveWindow(ID3D12Resource* bb, D3D12_RESOURCE_STATES& st) {
+    const D3D12_RESOURCE_DESC rd = bb->GetDesc();
+    const uint32_t w = uint32_t(rd.Width), h = rd.Height;
+    if (rd.Format != kBgra || w < 2 || h < 2) return;
+    Transition(bb, st, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    std::vector<uint8_t> px;
+    if (!ReadBack(bb, w, h, px)) return;
+    for (size_t i = 3; i < px.size(); i += 4) px[i] = 0xFF;
+    CapWrite("window", w, h, px);
+}
