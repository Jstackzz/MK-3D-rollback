+bool IsPlayer2(SDL_Gamepad* pad) {
+    if (!pad || g_controls.player2.empty()) return false;
+    const char* name = SDL_GetGamepadName(pad);
+    return name && SameText(name, g_controls.player2);
+}
+
+// the port a controller takes: player 2's named controller port 1; the rest the lowest free port, skipping port 1
+// while a player 2 controller is named (it stays free for that one)
+int PortFor(SDL_Gamepad* pad) {
+    if (IsPlayer2(pad)) {
+        if (!g_pads[1] || IsPlayer2(g_pads[1])) return g_pads[1] ? -1 : 1;
+        // another controller sits on port 1: it moves to the lowest free port
+        for (int i = 0; i < 4; i++)
+            if (i != 1 && !g_pads[i]) {
+                g_pads[i] = g_pads[1];
+                g_pads[1] = nullptr;
+                LOGI("input: controller moved to port %d for player 2's", i + 1);
+                return 1;
+            }
+        return -1;
+    }
+    for (int i = 0; i < 4; i++) {
+        if (i == 1 && !g_controls.player2.empty()) continue;
+        if (!g_pads[i]) return i;
+    }
+    return g_pads[1] || !g_controls.player2.empty() ? -1 : 1;
+}
