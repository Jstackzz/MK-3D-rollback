+    LOGI("input: controller %d plugged in: %s%s", port + 1, name ? name : "", IsPlayer2(pad) ? " (player 2's)" : "");
+}
+
+// the controls file named another player 2 controller: the pads take their ports again by the rule
+void PlacePadsAgain() {
+    SDL_Gamepad* pads[4];
+    std::copy(std::begin(g_pads), std::end(g_pads), pads);
+    std::fill(std::begin(g_pads), std::end(g_pads), nullptr);
+    // player 2's first, so it gets port 1
+    for (int pass = 0; pass < 2; pass++)
+        for (SDL_Gamepad* pad : pads) {
+            if (!pad || (pass == 0) != IsPlayer2(pad)) continue;
+            const int port = PortFor(pad);
+            if (port < 0) {
+                LOGI("input: no port free for %s", SDL_GetGamepadName(pad));
+                SDL_CloseGamepad(pad);
+                continue;
+            }
+            g_pads[port] = pad;
+            LOGI("input: controller %d: %s%s", port + 1, SDL_GetGamepadName(pad), IsPlayer2(pad) ? " (player 2's)" : "");
+        }
 }
 
