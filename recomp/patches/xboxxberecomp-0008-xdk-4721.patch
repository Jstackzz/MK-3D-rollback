+# XDK 4721 library data layouts the runtime reads or writes. Each value is proven by the default.xbe of Mortal
+# Kombat: Deadly Alliance (USA, Rev 1, title 4D57000C, XBE sha1 5aba0b06995b2179673a9ff05bcf5d0e16a9bc57) at the
+# address given. The D3D8 CDevice of 4721 has the 4831 layout throughout (static device 0x1E10E0, its miniport at
+# +0x23C0, see the device teardown 0x1D9E9B); 4721 lacks D3DDevice_SetIndices and SetGammaRamp, so those keys are
+# proven by the code that reads or releases the same fields.
+[layout]
+# D3D8 CDevice, the static device D3D__pDevice points at (Direct3D_CreateDevice 0x1D63C9 / 0x1D63D3)
+CDevice_Push              = 0x0    # D3DDevice_SetTexture 0x1D5632 reads it, compares with +4, calls MakeSpace 0x1D6260
+CDevice_PushThreshold     = 0x4    # D3DDevice_SetTexture 0x1D5634 compares the push pointer with it
+CDevice_BaseVertex        = 0x1C   # D3DDevice_DrawIndexedVertices 0x1D470E passes it to CDevice_SetStateVB 0x1D8C50
+CDevice_IndexBuffer       = 0x38C  # the device teardown 0x1D9EBE releases it with the textures (+0xB38) and palettes (+0xB48)
+CDevice_ZScale            = 0x510  # D3DDevice_GetViewportOffsetAndScale 0x1D2B75 scales the Z range by it
+CDevice_SuperSampleX      = 0x518  # D3DDevice_GetViewportOffsetAndScale 0x1D2ACE scales viewport X by it
+CDevice_SuperSampleY      = 0x51C  # D3DDevice_GetViewportOffsetAndScale 0x1D2AF0 scales viewport Y by it
+CDevice_Transforms        = 0x810  # D3DDevice_SetTransform 0x1D4DC6 copies 16 dwords to +0x810 + type * 64
+CDevice_Textures          = 0xB38  # D3DDevice_SetTexture 0x1D55F0 reads, 0x1D5629 stores [stage]
+CDevice_Palettes          = 0xB48  # D3DDevice_SetPalette 0x1D576D reads, 0x1D57A5 stores [stage]
+CDevice_RenderTarget      = 0x21B4 # D3DDevice_GetRenderTarget2 0x1D5176 returns it
+CDevice_Depth             = 0x21B8 # D3DDevice_GetDepthStencilSurface2 0x1D5196 returns it
+CDevice_BackBuffer        = 0x21C0 # D3DDevice_GetBackBuffer2 0x1D5150 returns it for index 0
+CDevice_FrontBuffer       = 0x21C4 # D3DDevice_GetBackBuffer2 0x1D5135 returns it for index -1 (+0x21C0 + 1 * 4)
+CDevice_SwapCount         = 0x2C10 # D3DDevice_Swap 0x1DE980 increments it, 0x1DE9F1 returns it
+CDevice_Size              = 0x2C30 # Direct3D_CreateDevice 0x1D640B clears 0xB0C dwords of the device on failure
+CDevice_Flags             = 0x8    # Direct3D_CreateDevice 0x1D63E3 ors BehaviorFlags & 0x10 into it, D3DDevice_SetPixelShader 0x1D2641 tests that bit
+CDevice_Time              = 0x30   # D3D_SetFence 0x1D5F0D pushes it, 0x1D5F83 adds 2
+CDevice_PixelShader       = 0x370  # D3DDevice_SetPixelShader 0x1D2578 stores the handle
+CDevice_VertexShader      = 0x380  # the device init 0x1D9D68 stores the FVF shader object 0x1E0FB0, D3DDevice_SetVertexShader 0x1D23F8 the current one
+CDevice_VertexShaderHandle = 0x384 # D3DDevice_SetVertexShader 0x1D23FE and SelectVertexShader 0x1D20C3 store the handle (no GetVertexShader in 4721)
+CDevice_Material          = 0xAB0  # D3DDevice_SetMaterial 0x1D4F1C copies its 17 dwords to +0xAB0
+CDevice_BackBufferScale   = 0x528  # the frame buffer init 0x1D949B stores the X scale as a float, 0x1D94B4 the Y scale at +4
+CDevice_Viewport          = 0xA90  # D3DDevice_SetViewport 0x1D52AB to 0x1D52CF stores X, Y, Width, Height, MinZ, MaxZ
+CDevice_ScreenSpaceOffset = 0xAA8  # D3DDevice_SetScreenSpaceOffset 0x1D5AA3 stores x + 0.53125, 0x1D5AB3 y + 0.53125 at +4
+CDevice_AutoDepth         = 0x21CC # the frame buffer init 0x1D9562 stores the depth buffer, D3D_InitDefaultState 0x1D9240 reads it
+CDevice_VBlankCallback    = 0x2550 # the vertical blank handler 0x1DA9DE calls [miniport + 0x190]
+CDevice_VBlankEvent       = 0x2554 # D3DDevice_BlockUntilVerticalBlank 0x1D4FAD waits on it, 0x1D4F9B clears its SignalState; the handler 0x1DA9D8 sets miniport + 0x194
+CDevice_DisplayFlags      = 0x2574 # the vertical blank handler 0x1DA97D tests miniport + 0x1B4 (0x1000000), the mode set 0x1DA2CA stores it
+CDevice_VBlankCount       = 0x2580 # the vertical blank handler 0x1DA934 to 0x1DA941 increments miniport + 0x1C0
+CDevice_Field             = 0x2590 # the vertical blank handler 0x1DA9A4 and 0x1DA9B3 store the field at miniport + 0x1D0
+CDevice_GammaRamps        = 0x259C # the flip handler 0x1DA8B4 loads the ramp at miniport + 0x1DC + index * 0x300; 0x1DB1C3 fills an identity ramp there
+CDevice_GammaPending      = 0x2B9C # the flip handler 0x1DA8A4 tests and 0x1DA8C3 clears [miniport + 0x7DC + index * 4]
+# D3D8 globals
+DirtyFlags_Texture        = 0x4800 # D3DDevice_SetTexture 0x1D5665 ors it into D3D__DirtyFlags
+TextureState_Stage        = 32     # D3DDevice_SetTextureStageStateNotInline 0x1D34FB: [stage * 32 + type] dwords
+Stream_Size               = 12     # D3DDevice_SetStreamSource 0x1D1F6A indexes the stream table by n * 12
+Stream_Stride             = 0x0    # D3DDevice_SetStreamSource 0x1D1FB2 stores Stride
+Stream_Buffer             = 0x8    # D3DDevice_SetStreamSource 0x1D1FB8 stores the vertex buffer
+PixelShader_Definition    = 0x8    # D3DDevice_CreatePixelShader 0x1D2511 stores the definition pointer, D3DDevice_SetPixelShader 0x1D25E0 reads it
+# DSOUND
+CDirectSoundStream_Vtable  = 0x0   # CDirectSoundStream constructor 0x1E5990 stores the first vtable
+CDirectSoundStream_Vtable2 = 0x4   # CDirectSoundStream constructor 0x1E5989 stores the second vtable
+EffectsImage_Skip0         = 0x804 # 0x1E7170 (reached from CDirectSound_DownloadEffectsImage 0x1E41C3 via 0x1E3FC0, 0x1E73C4) adds this dword count
+EffectsImage_Skip1         = 0x80C # 0x1E716A loads this dword count
+EffectsImage_Desc          = 0x818 # 0x1E7179: descriptor at image + 0x818 + (Skip0 + Skip1) * 4
+# XAPI XPP device type record
+XPP_Current               = 0x0    # XGetDevices 0x22AE96 returns it
+XPP_Changed               = 0x4    # XGetDevices 0x22AE98 clears it, XGetDeviceChanges 0x22AEB6 tests it
+XPP_Previous              = 0x8    # XGetDevices 0x22AE9E copies Current into it
