+// Netplay rollback: a frame run again to catch up is not shown (SetSkipPresent, at the frame's top), nor drawn: its
+// draws and clears are dropped. A rollback runs a few frames again inside one, and drawing them, which nobody sees,
+// made the frame shown after them late. What the title can see of the renderer stays as it was: states, fences,
+// copies, read-backs and visibility reports (which count no pixels then). Calls after a swap and before the next
+// frame's top are drawn, whichever frame they turn out to be; XBE_DRAW_UNSEEN draws every frame, as before.
+std::atomic<bool> g_skip_present{false};
+std::atomic<bool> g_frame_top{false};  // the top of a frame came since the last swap
+bool g_count_before_top = false;       // the last swap closed a match's frame: count until the next top
+uint32_t g_before_top = 0;             // draws and clears between that swap and the next frame's top
+
+// true when the draw or clear being called is dropped
+bool DropDraw() {
+    static const bool draw_unseen = std::getenv("XBE_DRAW_UNSEEN") != nullptr;
+    if (!g_frame_top) {
+        if (g_count_before_top) g_before_top++;
+        return false;
+    }
+    return g_skip_present && !draw_unseen;
+}
