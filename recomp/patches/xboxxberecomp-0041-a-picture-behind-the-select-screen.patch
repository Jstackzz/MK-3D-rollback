+// a picture file (PNG, or whatever else Windows' imaging decodes) as BGRA rows, none when it cannot be read
+static std::vector<uint8_t> LoadPicture(const std::filesystem::path& path, uint32_t& w, uint32_t& h) {
+    std::vector<uint8_t> px;
+    const HRESULT co = CoInitializeEx(nullptr, COINIT_MULTITHREADED);  // fails harmlessly where COM already runs
+    {
+        ComPtr<IWICImagingFactory> wic;
+        ComPtr<IWICBitmapDecoder> decoder;
+        ComPtr<IWICBitmapFrameDecode> frame;
+        ComPtr<IWICBitmapSource> bgra;
+        UINT pw = 0, ph = 0;
+        if (SUCCEEDED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&wic))) &&
+            SUCCEEDED(wic->CreateDecoderFromFilename(path.c_str(), nullptr, GENERIC_READ,
+                                                     WICDecodeMetadataCacheOnDemand, &decoder)) &&
+            SUCCEEDED(decoder->GetFrame(0, &frame)) &&
+            SUCCEEDED(WICConvertBitmapSource(GUID_WICPixelFormat32bppBGRA, frame.Get(), &bgra)) &&
+            SUCCEEDED(bgra->GetSize(&pw, &ph)) && pw && ph && pw <= 8192 && ph <= 8192) {
+            px.resize(size_t(pw) * ph * 4);
+            if (FAILED(bgra->CopyPixels(nullptr, pw * 4, UINT(px.size()), px.data()))) px.clear();
+            w = pw;
+            h = ph;
+        }
+    }
+    if (SUCCEEDED(co)) CoUninitialize();
+    return px;
+}
