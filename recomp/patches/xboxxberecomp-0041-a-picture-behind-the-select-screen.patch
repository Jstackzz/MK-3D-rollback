+// the user's image over the whole target (kUserImagePrim): the 4:3 picture is stretched to 16:9 when Settings say so,
+// so the image goes in whole then, else its middle 4:3
+void D3D12Backend::DrawUserImage(const State& s) {
+    if (!user_image_tried_) {
+        user_image_tried_ = true;
+        const auto path = app::ExeDir() / "select_background.png";
+        uint32_t w = 0, h = 0;
+        std::vector<uint8_t> px = LoadPicture(path, w, h);
+        if (px.empty()) {
+            LOGR("d3d12: no picture in %s: the select screen keeps its own background", path.string().c_str());
+        } else {
+            user_image_ = CreatePixelTexture(px, w * 4, w, h);
+            user_w_ = w;
+            user_h_ = h;
+            LOGR("d3d12: the select screen's background: %ux%u from %s", w, h, path.string().c_str());
+        }
+    }
+    if (!user_image_) return;
+    Target* rt = EnsureTarget(s.rt, false);
+    if (!rt) return;
+    if (LatchCpuWrite(*rt)) UploadTarget(*rt, s.rt);
+    Transition(rt->res.Get(), rt->state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    rt->drawn = true;
+    SetBlitTarget(Cpu(rtv_heap_.Get(), rt->view, rtv_inc_), rt->w, rt->h);
+    float uv[4] = {0, 0, 1, 1};
+    const float aspect = float(user_w_) / float(user_h_), shown = app::Get().stretch_4x3 ? 16.0f / 9 : 4.0f / 3;
+    if (aspect > shown) {
+        uv[2] = shown / aspect;
+        uv[0] = (1 - uv[2]) / 2;
+    }
+    Blit(user_image_.Get(), kBgra, uv, {.mul = 1 / rt->range, .rtv = rt->fmt});
+}
