+// true when the game's filter took the draw: skipped, or its image drawn instead
+bool Filtered(uint32_t prim, uint32_t count, const void* vertices, uint32_t stride) {
+    if (!g_draw_filter) return false;
+    const int choice = g_draw_filter(g_state, prim, count, static_cast<const uint8_t*>(vertices), stride);
+    if (choice == d3d::kDrawImage && g_backend) g_backend->Draw(g_state, gpu::kUserImagePrim, 0, 0, nullptr);
+    return choice != d3d::kDrawAsIs;
+}
+
+// a draw from the bound vertex buffers: stream 0's vertices from the first one drawn, where the renderer reads them
+// (its D3DVertexBuffer's data at +4, a physical address); an indexed draw passes none
+bool FilteredStream(uint32_t prim, uint32_t count, bool indexed, uint32_t first) {
+    if (!g_draw_filter) return false;
+    const auto& st = g_state.streams[0];
+    const uint8_t* vertices = nullptr;
+    if (!indexed && st.vb && st.stride) {
+        vertices = static_cast<const uint8_t*>(HostPtr(mem::VirtualFromPhysical(R32(st.vb + 4))));
+        vertices += size_t(first) * st.stride;
+    }
+    return Filtered(prim, count, vertices, vertices ? st.stride : 0);
+}
