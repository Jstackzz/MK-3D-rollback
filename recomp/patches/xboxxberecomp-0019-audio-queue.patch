+// XBE_AUDIO_DUMP=<file.wav>: everything sent to the speakers (48 kHz float stereo), to find where the sound breaks
+void DumpHeader(std::FILE* f, uint32_t frames) {
+    const uint32_t data = frames * 8;
+    struct {
+        char riff[4] = {'R', 'I', 'F', 'F'};
+        uint32_t size;
+        char wave[8] = {'W', 'A', 'V', 'E', 'f', 'm', 't', ' '};
+        uint32_t fmt_size = 16;
+        uint16_t tag = 3, channels = 2;  // WAVE_FORMAT_IEEE_FLOAT
+        uint32_t rate = kRate, bytes_per_sec = kRate * 8;
+        uint16_t align = 8, bits = 32;
+        char data_id[4] = {'d', 'a', 't', 'a'};
+        uint32_t data_size;
+    } h;
+    h.size = 36 + data;
+    h.data_size = data;
+    std::fseek(f, 0, SEEK_SET);
+    std::fwrite(&h, sizeof h, 1, f);
+    std::fseek(f, 0, SEEK_END);
+}
+
