+    if (!g_fifo_playing && queued >= kFifoTarget) {
+        g_fifo_playing = true;
+        g_fifo_at = 0;
+        g_fifo_rate = 1;
+        g_fifo_fade_in = kFifoFade;
+    }
+    if (!g_fifo_playing) {
