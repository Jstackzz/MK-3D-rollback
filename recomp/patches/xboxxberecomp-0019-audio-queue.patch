+        for (uint32_t k = 0; k < fade; k++) {
+            const float gain = float(k) / float(fade);
+            out[size_t(i - fade + k) * 2] *= 1 - gain;
+            out[size_t(i - fade + k) * 2 + 1] *= 1 - gain;
