+// what the output lost, at most once a second (under g_lock): streams started but without a packet in time, and the
+// frame clock's queue running empty (silence) or over (sound dropped)
+void ReportGaps() {
+    static int64_t last = 0;
+    const int64_t now = NowMs();
+    if (now - last < 1000) return;
+    last = now;
+    for (auto& [obj, v] : g_voices) {
+        if (!v.starved) continue;
+        LOGR("dsound: stream %08X (%u Hz, %u ch) ran dry for %u ms", obj, v.freq ? v.freq : v.rate, v.channels,
+             v.starved * 1000 / audio::kRate);
+        v.starved = 0;
+    }
+    const uint32_t silent = g_fifo_silent.exchange(0), dropped = g_fifo_dropped.exchange(0);
+    if (silent || dropped)
+        LOGR("dsound: frame clock: %u ms of silence, %u ms dropped", silent * 1000 / audio::kRate,
+             dropped * 1000 / audio::kRate);
