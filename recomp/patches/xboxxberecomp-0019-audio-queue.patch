+    // toward the target, gently: a step of the rate every block, at most kFifoStretch off
+    const double off = (double(queued) - double(kFifoTarget)) / double(kFifoTarget);
+    const double want = 1 + std::clamp(off * kFifoStretch, -kFifoStretch, kFifoStretch);
+    g_fifo_rate += (want - g_fifo_rate) * 0.1;
+    uint32_t i = 0;
+    for (; i < frames; i++) {
+        const size_t f = size_t(g_fifo_at);
+        if (f + 1 >= queued) break;
+        const float t = float(g_fifo_at - double(f));
+        float gain = 1;
+        if (g_fifo_fade_in) gain = 1 - float(g_fifo_fade_in--) / float(kFifoFade);
+        for (size_t c = 0; c < 2; c++) {
