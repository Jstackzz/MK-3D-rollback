     sd.BufferCount = kFrames;
     sd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
-    sd.Flags = tearing_ ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+    sd.Flags = SwapFlags();
     ComPtr<IDXGISwapChain1> sc1;
     if (FAILED(factory_->CreateSwapChainForHwnd(queue_.Get(), hwnd, &sd, nullptr, nullptr, &sc1))) {
         LOGE("d3d12: no swap chain");
@@ -803,7 +808,21 @@
     }
     factory_->MakeWindowAssociation(hwnd, DXGI_MWA_NO_ALT_ENTER);
     sc1.As(&swap_);
+    // DXGI's default lets three presented frames wait for the display: a title paced at 60 frames a second on a
+    // display a hair slower (59.94 Hz) fills that queue within a minute, and every press then shows three refreshes
+    // late. One frame queued at most, and the next frame starts once the display took the last (WaitForDisplay).
+    if (swap_ && SUCCEEDED(swap_->SetMaximumFrameLatency(1))) latency_ = swap_->GetFrameLatencyWaitableObject();
     return true;
+}
+
+// after a present: wait (not alertable: the title's file APCs are its own) until the swap chain takes another frame,
+// so the next frame reads its input a refresh before it is shown. Never long: a window the display does not show
+// (minimised, occluded) may not be signalled, and a match must not slow down for it.
+void D3D12Backend::WaitForDisplay(HRESULT presented) {
+    if (!latency_ || presented == DXGI_STATUS_OCCLUDED) return;
+    HWND hwnd = static_cast<HWND>(app::Window());
+    if (hwnd && (IsIconic(hwnd) || !IsWindowVisible(hwnd))) return;
+    WaitForSingleObjectEx(latency_, 25, FALSE);
 }
 
