+    UINT SwapFlags() const {
+        return DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT | (tearing_ ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+    }
+    void WaitForDisplay(HRESULT presented);
